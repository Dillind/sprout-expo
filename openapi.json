{
  "openapi": "3.0.3",
  "info": {
    "title": "Sprout API",
    "description": "Plant management API for the Sprout app",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:8081/api", "description": "Development" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Plant": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "name": { "type": "string", "example": "Monstera Deliciosa" },
          "photoUrl": { "type": "string", "nullable": true },
          "location": { "type": "string", "example": "living-room" },
          "wateringDays": { "type": "integer", "example": 7 },
          "remindersEnabled": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreatePlantRequest": {
        "type": "object",
        "required": ["name", "location"],
        "properties": {
          "name": { "type": "string" },
          "photoUrl": { "type": "string", "nullable": true },
          "location": { "type": "string" },
          "wateringDays": { "type": "integer", "default": 7 },
          "remindersEnabled": { "type": "boolean", "default": false }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/plants": {
      "get": {
        "summary": "List plants for authenticated user",
        "operationId": "listPlants",
        "responses": {
          "200": {
            "description": "Array of plants",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "plants": { "type": "array", "items": { "$ref": "#/components/schemas/Plant" } } } } } }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create a plant",
        "operationId": "createPlant",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePlantRequest" } } }
        },
        "responses": {
          "201": { "description": "Plant created", "content": { "application/json": { "schema": { "type": "object", "properties": { "plant": { "$ref": "#/components/schemas/Plant" } } } } } },
          "400": { "description": "Missing required fields" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/plants/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "summary": "Get a plant by ID",
        "operationId": "getPlant",
        "responses": {
          "200": { "description": "Plant", "content": { "application/json": { "schema": { "type": "object", "properties": { "plant": { "$ref": "#/components/schemas/Plant" } } } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "summary": "Update a plant",
        "operationId": "updatePlant",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePlantRequest" } } } },
        "responses": { "200": { "description": "Updated plant" }, "401": { "description": "Unauthorized" }, "404": { "description": "Not found" } }
      },
      "delete": {
        "summary": "Delete a plant",
        "operationId": "deletePlant",
        "responses": { "204": { "description": "Deleted" }, "401": { "description": "Unauthorized" }, "404": { "description": "Not found" } }
      }
    }
  }
}
