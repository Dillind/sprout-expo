generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CareType {
  WATER
  FERTILIZE
  REPOT
}

model Plant {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  name             String
  photoUrl         String?  @map("photo_url")
  location         String
  wateringDays     Int      @default(7) @map("watering_days")
  remindersEnabled Boolean  @default(false) @map("reminders_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  waterAmountMl    Int?      @map("water_amount_ml")
  fertilizeDays    Int?      @map("fertilize_days")
  repotDays        Int?      @map("repot_days")
  lastWateredAt    DateTime? @map("last_watered_at")
  lastFertilizedAt DateTime? @map("last_fertilized_at")
  lastRepottedAt   DateTime? @map("last_repotted_at")
  careLogs         PlantCareLog[]
  customTasks      CustomTask[]

  @@map("plants")
}

model PlantCareLog {
  id        String   @id @default(cuid())
  plantId   String   @map("plant_id")
  userId    String   @map("user_id")
  type      CareType
  doneAt    DateTime @map("done_at")
  createdAt DateTime @default(now()) @map("created_at")
  plant     Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId])
  @@index([userId])
  @@map("plant_care_logs")
}

model CustomTask {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  plantId     String?   @map("plant_id")
  title       String
  type        CareType
  dueDate     DateTime  @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  plant       Plant?    @relation(fields: [plantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dueDate])
  @@map("custom_tasks")
}
