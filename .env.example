EXPO_PUBLIC_NODE_ENV="development"

# Supabase — retrieve from: Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth — create client IDs at: console.cloud.google.com > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=        # iOS OAuth 2.0 client ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=    # Android OAuth 2.0 client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=        # Web OAuth 2.0 client ID (Supabase uses this to validate tokens)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=       # REVERSED_CLIENT_ID from GoogleService-Info.plist (e.g. com.googleusercontent.apps.xxx)
